# Copy to backend/.env to override defaults. Every setting is optional.

# Claude reads vendor email when this is set; without it Recoup uses keyword rules.
# Server-side only: the browser never sees it.
# ANTHROPIC_API_KEY=
# RECOUP_LLM=auto            # auto | on | off
# RECOUP_LLM_MODEL=claude-opus-5-5
# RECOUP_LLM_EFFORT=medium   # low | medium | high

# SQLite needs no install. Postgres works too (CI runs the suite against both).
RECOUP_DATABASE_URL=sqlite:///./recoup.db
# RECOUP_DATABASE_URL=postgresql+psycopg://recoup:recoup@localhost:5432/recoup

# Demo controls (POST /api/demo/connect, scan, advance and reset). Reset deletes every row, and
# refuses if the ledger holds anything but demo data. `make api` turns this on; never enable in
# production.
# RECOUP_DEMO_MODE=false
# Adds a few months of already-won and in-flight claims to the demo when it scans.
# RECOUP_DEMO_HISTORY=false

# The company name the UI shows. Letters are signed with the name saved in Setup, if any.
# RECOUP_ORG_NAME=Acme Inc.

# Detection clock. Unset: the dataset's own date (Oct 1, 2026), then today.
# RECOUP_AS_OF=2026-10-01

# Hard stops (amounts in minor units: 2500 = $25.00)
RECOUP_DUPLICATE_WINDOW_DAYS=3
RECOUP_MIN_RECOVERABLE_MINOR=2500
RECOUP_DISPUTE_WINDOW_DAYS=120
RECOUP_PROMISE_DEFAULT_DAYS=14
RECOUP_PROMISE_GRACE_DAYS=3

# Where dispute packets go for vendors not in the directory.
RECOUP_CARD_DISPUTE_ADDRESS=disputes@card-issuer.example

# Ramp Developer API (sync real transactions). Sandbox apps have their own credentials.
# RECOUP_RAMP_CLIENT_ID=
# RECOUP_RAMP_CLIENT_SECRET=
# RECOUP_RAMP_ENV=sandbox    # sandbox | production

# Gmail, read-only (vendor replies). Create a Desktop OAuth client in Google Cloud,
# then run `recoup connect gmail`, which writes the refresh token below.
# RECOUP_GMAIL_CLIENT_ID=
# RECOUP_GMAIL_CLIENT_SECRET=
# RECOUP_GMAIL_REFRESH_TOKEN=
# Send approved requests from this mailbox instead of the local outbox. Adds the
# gmail.send scope, so run `recoup connect gmail` again after turning it on.
# RECOUP_GMAIL_SEND=false
# RECOUP_GMAIL_LOOKBACK_DAYS=180
# RECOUP_GMAIL_MAX_MESSAGES=500

# Sync every connector, then re-run detection, every N minutes inside the API. 0 is off.
# RECOUP_SYNC_INTERVAL_MINUTES=0
